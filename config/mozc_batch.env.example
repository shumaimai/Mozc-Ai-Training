# Local paths for the Mozc candidate-generation pipeline.
# Copy to config/mozc_batch.env and edit. That file is gitignored.

# Built with: bazelisk build //converter:mozc_batch -c opt ...
MOZC_BATCH_EXE=C:\path\to\mozc\src\bazel-bin\converter\mozc_batch.exe

# Engine data from //data_manager/oss:mozc_dataset_for_oss (-c opt).
# Prefer a stable copy under tools/mozc/mozc.data — bazel-bin may point at
# fastbuild after later builds and miss the opt artifact.
MOZC_ENGINE_DATA_PATH=C:\path\to\Mozc-Ai-Training\tools\mozc\mozc.data

# Default top-N for training classify (docs use 50).
MOZC_MAX_CANDIDATES=50
